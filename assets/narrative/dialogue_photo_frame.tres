[sub_resource type="Resource" id="NarrativeLine_2"]
speaker_id = &"xiaoming"
script = ExtResource("2_line")
speaker_name = "晓明"
audio_id = &"voice_photo_frame_02"
text = "因为看不见，其实我不怎么拍照……这张算是为数不多的几张了。"
